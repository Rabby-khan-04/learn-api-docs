// Prisma schema for the api_learn throwaway database.
// Every tenant-owned table carries tenantId, and composite unique keys let
// foreign keys enforce "no cross-tenant links" at the database level.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum OrderStatus {
  PENDING
  PAID
  FULFILLED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED
}

enum CouponType {
  PERCENT
  FIXED
}

enum FraudAction {
  BAN
  UNBAN
}

enum OperationStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Tenant {
  id        String   @id @db.VarChar(30)
  slug      String   @unique @db.VarChar(50)
  name      String   @db.VarChar(120)
  plan      String   @default("FREE") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  products       Product[]
  customers      Customer[]
  orders         Order[]
  orderItems     OrderItem[]
  coupons        Coupon[]
  redemptions    CouponRedemption[]
  payments       Payment[]
  fraudEvents    FraudEvent[]
  idempotencyKeys IdempotencyKey[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  operations     Operation[]
  uploads        Upload[]

  @@map("tenants")
}

model Product {
  id          String    @id @db.VarChar(50)
  tenantId    String    @map("tenant_id") @db.VarChar(30)
  sku         String    @db.VarChar(40)
  slug        String    @db.VarChar(80)
  name        String    @db.VarChar(200)
  description String?   @db.Text
  priceCents  Int       @map("price_cents")
  currency    String    @db.VarChar(3)
  stock       Int       @default(0)
  active      Boolean   @default(true)
  version     Int       @default(1)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz(3)

  tenant     Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, slug])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, active, priceCents])
  @@map("products")
}

model Customer {
  id        String    @id @db.VarChar(50)
  tenantId  String    @map("tenant_id") @db.VarChar(30)
  email     String    @db.VarChar(254)
  name      String    @db.VarChar(120)
  bannedAt  DateTime? @map("banned_at") @db.Timestamptz(3)
  banReason String?   @map("ban_reason") @db.VarChar(500)
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant         Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders         Order[]
  redemptions    CouponRedemption[]
  fraudEvents    FraudEvent[]

  @@unique([tenantId, email])
  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, name])
  @@map("customers")
}

model Order {
  id               String      @id @db.VarChar(50)
  tenantId         String      @map("tenant_id") @db.VarChar(30)
  customerId       String      @map("customer_id") @db.VarChar(50)
  status           OrderStatus @default(PENDING)
  subtotalCents    Int         @map("subtotal_cents")
  discountCents    Int         @default(0) @map("discount_cents")
  totalCents       Int         @map("total_cents")
  currency         String      @db.VarChar(3)
  couponId         String?     @map("coupon_id") @db.VarChar(50)
  couponCode       String?     @map("coupon_code") @db.VarChar(40)
  idempotencyKeyId String?     @unique @map("idempotency_key_id") @db.VarChar(50)
  version          Int         @default(1)
  createdAt        DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant     Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer   Customer         @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)
  coupon     Coupon?          @relation(fields: [tenantId, couponId], references: [tenantId, id], onDelete: Restrict)
  items      OrderItem[]
  payments   Payment[]
  redemptions CouponRedemption[]

  @@unique([tenantId, id])
  @@index([tenantId, createdAt, id])
  @@index([tenantId, customerId])
  @@map("orders")
}

model OrderItem {
  id             String @id @db.VarChar(50)
  tenantId       String @map("tenant_id") @db.VarChar(30)
  orderId        String @map("order_id") @db.VarChar(50)
  productId      String @map("product_id") @db.VarChar(50)
  skuSnapshot    String @map("sku_snapshot") @db.VarChar(40)
  nameSnapshot   String @map("name_snapshot") @db.VarChar(200)
  unitPriceCents Int    @map("unit_price_cents")
  quantity       Int
  lineTotalCents Int    @map("line_total_cents")

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  product Product @relation(fields: [tenantId, productId], references: [tenantId, id], onDelete: Restrict)

  @@index([tenantId, orderId])
  @@map("order_items")
}

model Payment {
  id           String        @id @db.VarChar(50)
  tenantId     String        @map("tenant_id") @db.VarChar(30)
  orderId      String        @map("order_id") @db.VarChar(50)
  amountCents  Int           @map("amount_cents")
  currency     String        @db.VarChar(3)
  status       PaymentStatus @default(PENDING)
  provider     String        @db.VarChar(40)
  providerRef  String        @map("provider_ref") @db.VarChar(100)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  order  Order  @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, id])
  @@index([tenantId, orderId])
  @@map("payments")
}

model Coupon {
  id              String     @id @db.VarChar(50)
  tenantId        String     @map("tenant_id") @db.VarChar(30)
  code            String     @db.VarChar(40)
  type            CouponType
  percentOff      Int?       @map("percent_off")
  amountOffCents  Int?       @map("amount_off_cents")
  currency        String     @db.VarChar(3)
  startsAt        DateTime   @map("starts_at") @db.Timestamptz(3)
  endsAt          DateTime   @map("ends_at") @db.Timestamptz(3)
  maxRedemptions  Int        @map("max_redemptions")
  redemptionCount Int        @default(0) @map("redemption_count")
  active          Boolean    @default(true)
  version         Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant      Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orders      Order[]
  redemptions CouponRedemption[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("coupons")
}

model CouponRedemption {
  id         String   @id @db.VarChar(50)
  tenantId   String   @map("tenant_id") @db.VarChar(30)
  couponId   String   @map("coupon_id") @db.VarChar(50)
  orderId    String   @map("order_id") @db.VarChar(50)
  customerId String   @map("customer_id") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  coupon   Coupon   @relation(fields: [tenantId, couponId], references: [tenantId, id], onDelete: Restrict)
  order    Order    @relation(fields: [tenantId, orderId], references: [tenantId, id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Restrict)

  @@unique([tenantId, couponId, orderId])
  @@index([tenantId, couponId])
  @@map("coupon_redemptions")
}

model FraudEvent {
  id         String      @id @db.VarChar(50)
  tenantId   String      @map("tenant_id") @db.VarChar(30)
  customerId String      @map("customer_id") @db.VarChar(50)
  action     FraudAction
  reason     String      @db.VarChar(500)
  actor      String      @db.VarChar(100)
  createdAt  DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [tenantId, customerId], references: [tenantId, id], onDelete: Cascade)

  @@index([tenantId, customerId, createdAt])
  @@map("fraud_events")
}

model IdempotencyKey {
  id           String   @id @db.VarChar(50)
  tenantId     String   @map("tenant_id") @db.VarChar(30)
  key          String   @db.VarChar(200)
  requestHash  String   @map("request_hash") @db.VarChar(64)
  method       String   @db.VarChar(10)
  path         String   @db.VarChar(300)
  statusCode   Int?     @map("status_code")
  responseBody Json?    @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt    DateTime @map("expires_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, key])
  @@index([tenantId, expiresAt])
  @@map("idempotency_keys")
}

model WebhookEndpoint {
  id        String   @id @db.VarChar(50)
  tenantId  String   @map("tenant_id") @db.VarChar(30)
  url       String   @db.VarChar(500)
  secret    String   @db.VarChar(100)
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@unique([tenantId, id])
  @@index([tenantId])
  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id            String         @id @db.VarChar(50)
  tenantId      String         @map("tenant_id") @db.VarChar(30)
  endpointId    String         @map("endpoint_id") @db.VarChar(50)
  eventId       String         @map("event_id") @db.VarChar(100)
  eventType     String         @map("event_type") @db.VarChar(80)
  payload       Json
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  lastError     String?        @map("last_error") @db.VarChar(500)
  nextAttemptAt DateTime?      @map("next_attempt_at") @db.Timestamptz(3)
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  deliveredAt   DateTime?      @map("delivered_at") @db.Timestamptz(3)

  tenant   Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  endpoint WebhookEndpoint @relation(fields: [tenantId, endpointId], references: [tenantId, id], onDelete: Cascade)

  @@unique([tenantId, eventId, endpointId])
  @@index([tenantId, status, nextAttemptAt])
  @@map("webhook_deliveries")
}

model Operation {
  id        String          @id @db.VarChar(50)
  tenantId  String          @map("tenant_id") @db.VarChar(30)
  type      String          @db.VarChar(40)
  status    OperationStatus @default(QUEUED)
  resultUrl String?         @map("result_url") @db.VarChar(500)
  error     String?         @db.VarChar(500)
  createdAt DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, createdAt])
  @@map("operations")
}

model Upload {
  id          String   @id @db.VarChar(50)
  tenantId    String   @map("tenant_id") @db.VarChar(30)
  productId   String?  @map("product_id") @db.VarChar(50)
  filename    String   @db.VarChar(255)
  contentType String   @map("content_type") @db.VarChar(100)
  sizeBytes   Int      @map("size_bytes")
  storageKey  String   @map("storage_key") @db.VarChar(300)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, productId])
  @@map("uploads")
}
