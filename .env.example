# Copy to .env. This project must only ever point at the local throwaway DB.
DATABASE_URL="postgresql://postgres:learn@localhost:5434/api_learn?schema=public"
PORT=4010
AUTH_ENABLED=on
RATE_LIMIT_ENABLED=off
RATE_LIMIT_MAX=3
RATE_LIMIT_WINDOW_SECONDS=60
CACHE_ENABLED=on
# on from chapter 14: /api is an alias of /v1 and announces its sunset.
LEGACY_DEPRECATION_HEADERS=on
UPLOAD_DIR=uploads
WEBHOOK_RECEIVER_URL=http://localhost:4020/hooks/orders
